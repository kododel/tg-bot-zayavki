# Токен бота, который выдаёт @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# ID администраторов через запятую. Узнать свой ID можно командой /id в боте.
ADMIN_IDS=123456789

# Информация о компании — подставляется в приветствие и раздел «О компании»
COMPANY_NAME=Ремонт квартир «Пример»
COMPANY_DESCRIPTION=Делаем ремонт под ключ: замер, смета, работы, приёмка. Работаем по договору, даём гарантию 2 года.
MANAGER_CONTACT=

# Проверка телефона. RU — по правилам российской нумерации: отсекает
# несуществующие коды и случайно набранные цифры. ANY — только общая
# проверка длины, если к вам обращаются клиенты из других стран.
PHONE_COUNTRY=RU

# Пути (можно не менять)
DB_PATH=data/applications.db
EXPORT_DIR=data/exports
